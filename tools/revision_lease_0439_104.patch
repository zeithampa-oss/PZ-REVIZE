+++ b/source/nas/tests/test_revision_leases_104.py
@@ -0,0 +1,32 @@
+import tempfile, unittest
+from pathlib import Path
+from unittest.mock import patch
+import server
+
+class RevisionLease104Tests(unittest.TestCase):
+    def setUp(self):
+        self.tmp=tempfile.TemporaryDirectory(); root=Path(self.tmp.name)
+        self.patches=[
+            patch.object(server,'DB_PATH',root/'data'/'pz_revize_shared.db'),
+            patch.object(server,'ATTACHMENTS_DIR',root/'data'/'attachments'),
+            patch.object(server,'CONFIG_PATH',root/'server_config.json'),
+            patch.object(server,'STATE_PATH',root/'data'/'state.json'),
+        ]
+        for p in self.patches:p.start()
+        self.state=server.ServerState()
+    def tearDown(self):
+        for p in reversed(self.patches):p.stop()
+        self.tmp.cleanup()
+    def test_single_owner_and_release(self):
+        a=self.state.acquire_revision_lease('26EI0001','pc-a','PC A',600)
+        self.assertTrue(a['ok'])
+        b=self.state.acquire_revision_lease('26EI0001','pc-b','PC B',600)
+        self.assertTrue(b['conflict'])
+        h=self.state.heartbeat_revision_lease('26EI0001','pc-a',600)
+        self.assertTrue(h['ok'])
+        r=self.state.release_revision_lease('26EI0001','pc-a')
+        self.assertTrue(r['released'])
+        c=self.state.acquire_revision_lease('26EI0001','pc-b','PC B',600)
+        self.assertTrue(c['ok'])
+
+if __name__=='__main__':unittest.main()
